# Tao .env bang: python3 scripts/init_env.py
# Khong commit .env, khong chia se mat khau trong anh/log/chat.
MYSQL_DATABASE=qlsv
MYSQL_USER=qlsv_app
MYSQL_PASSWORD=GENERATE_WITH_INIT_ENV
MYSQL_ROOT_PASSWORD=GENERATE_WITH_INIT_ENV
DJANGO_SECRET_KEY=GENERATE_WITH_INIT_ENV
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
WEB_PORT=8080
PMA_PORT=8081

# Moc 2: python3 scripts/init_monitoring.py se them vao .env hien co.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GENERATE_WITH_INIT_MONITORING
MYSQL_EXPORTER_PASSWORD=GENERATE_WITH_INIT_MONITORING

# Moc 3: python3 scripts/prepare_logging.py tu phat hien va them DOCKER_LOG_DIR.
# Khong sao chep duong dan mac dinh; script kiem tra DockerRootDir va LogPath thuc te.
