      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "qlsv-prometheus"
          },
          "editorMode": "code",
          "expr": "100 * sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",container_label_com_docker_compose_project=\"qlsv\",container_label_com_docker_compose_service!=\"\",container_label_com_docker_compose_service=~\"${service:regex}\"}[$__rate_interval]))",
